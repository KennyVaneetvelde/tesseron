{
  "name": "tesseron",
  "version": "0.0.0",
  "private": true,
  "description": "Expose typed web app actions to MCP-compatible AI agents over WebSocket. SDK + matching MCP gateway.",
  "license": "BUSL-1.1",
  "author": {
    "name": "Kenny Vaneetvelde",
    "email": "kenny@eigenwise.io",
    "url": "https://eigenwise.io/"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "sync-plugin-version": "node scripts/sync-plugin-version.mjs",
    "check-docs-changeset": "node scripts/check-docs-changeset.mjs",
    "sync-labels": "node scripts/sync-labels.mjs",
    "conformance:validate": "node conformance/validate.mjs",
    "conformance:run": "node conformance/run-reference.mjs",
    "conformance:run:rust": "node conformance/run-reference.mjs --host sdks/rust/target/debug/tesseron-conformance-host --unsupported host-minted-claim",
    "conformance:run:cpp": "node conformance/run-reference.mjs --host sdks/cpp/build/conformance-host/tesseron-conformance-host --unsupported host-minted-claim,uds",
    "conformance:run:python": "node conformance/run-reference.mjs --host \"uv run --locked --directory sdks/python python -m conformance_host\" --unsupported host-minted-claim,uds",
    "example:rust:e2e": "node sdks/rust/examples/validate-e2e.mjs",
    "example:python:e2e": "node sdks/python/examples/validate-e2e.mjs",
    "example:cpp:e2e": "node sdks/cpp/examples/validate-e2e.mjs",
    "version-packages": "changeset version && pnpm sync-plugin-version && biome format --write .",
    "docs:dev": "pnpm --filter @tesseron/docs start",
    "docs:build": "pnpm --filter @tesseron/docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "tsup": "^8.5.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
