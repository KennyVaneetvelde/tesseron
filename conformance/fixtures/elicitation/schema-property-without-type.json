            "type": "object",
            "properties": {
              "value": {
                "type": "~absent",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:elicitationId",
        "result": {
          "action": "accept",
          "value": {
            "value": "allowed"
          }
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "schema-accepted",
        "result": {
          "invocationId": "schema-accepted",
          "output": {
            "accepted": "missing-property-type"
          }
        }
