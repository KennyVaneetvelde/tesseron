        "id": "~capture:helloId",
        "method": "tesseron/hello"
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:helloId",
        "result": {
          "sessionId": "s_conformance_schema_0001",
          "protocolVersion": "1.2.0",
          "capabilities": {
            "streaming": true,
            "subscriptions": true,
            "sampling": true,
            "elicitation": true
          },
          "agent": {
            "id": "agent_conformance",
            "name": "conformance-runner"
          },
          "resumeToken": "rt_conformance_schema_0001"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "schema-accepted",
        "method": "actions/invoke",
        "params": {
          "name": "missingPropertyType",
          "input": {},
          "invocationId": "schema-accepted"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:elicitationId",
