{
  "id": "resources/subscribe-not-subscribable",
  "title": "Unknown and non-subscribable resources reject subscription requests",
  "spec": "/protocol/resources/",
  "requires": ["subscriptions"],
  "fixture": {
    "resources": [
      {
        "name": "snapshot",
        "value": { "status": "ready" }
      }
    ]
  },
  "steps": [
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:helloId",
        "method": "tesseron/hello",
        "params": {
          "protocolVersion": "~regex:^1\\.[0-9]+\\.[0-9]+$",
          "app": {
            "id": "~regex:^[a-z][a-z0-9_]*$",
            "name": "~string",
            "origin": "~string"
          },
          "actions": "~array",
          "resources": "~array",
          "capabilities": {
            "streaming": "~boolean",
            "subscriptions": "~boolean",
            "sampling": "~boolean",
            "elicitation": "~boolean"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:helloId",
        "result": {
          "sessionId": "s_conformance_0001",
          "protocolVersion": "1.2.0",
          "capabilities": {
            "streaming": true,
            "subscriptions": true,
            "sampling": true,
            "elicitation": true
          },
          "agent": {
            "id": "agent_conformance",
            "name": "conformance-runner"
          },
          "claimCode": "AB3X-7K",
          "resumeToken": "rt_conformance_0001"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "subscribe-unknown",
        "method": "resources/subscribe",
        "params": { "name": "missing", "subscriptionId": "sub-missing" }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "subscribe-unknown",
        "error": { "code": -32003, "message": "Resource not subscribable: missing" }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "subscribe-static",
        "method": "resources/subscribe",
        "params": { "name": "snapshot", "subscriptionId": "sub-snapshot" }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "subscribe-static",
        "error": { "code": -32003, "message": "Resource not subscribable: snapshot" }
      }
    }
  ]
}
