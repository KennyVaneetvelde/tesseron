{
  "id": "resources/subscribe-update-unsubscribe",
  "title": "A subscription pushes updates and stops cleanly on unsubscribe",
  "spec": "/protocol/resources/",
  "requires": ["subscriptions"],
  "fixture": {
    "resources": [
      {
        "name": "cart",
        "value": {
          "total": 0
        },
        "subscribable": true,
        "emits": [
          {
            "afterStep": "subscribed",
            "value": {
              "total": 42
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "~capture:helloId",
        "method": "tesseron/hello",
        "params": {
          "protocolVersion": "~regex:^1\\.[0-9]+\\.[0-9]+$",
          "app": {
            "id": "~regex:^[a-z][a-z0-9_]*$",
            "name": "~string",
            "origin": "~string"
          },
          "actions": "~array",
          "resources": "~array",
          "capabilities": {
            "streaming": "~boolean",
            "subscriptions": "~boolean",
            "sampling": "~boolean",
            "elicitation": "~boolean"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "~ref:helloId",
        "result": {
          "sessionId": "s_conformance_0001",
          "protocolVersion": "1.2.0",
          "capabilities": {
            "streaming": true,
            "subscriptions": true,
            "sampling": true,
            "elicitation": true
          },
          "agent": {
            "id": "agent_conformance",
            "name": "conformance-runner"
          },
          "claimCode": "AB3X-7K",
          "resumeToken": "rt_conformance_0001"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "s-1",
        "method": "resources/subscribe",
        "params": {
          "name": "cart",
          "subscriptionId": "sub-1"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "s-1"
      },
      "label": "subscribed"
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "method": "resources/updated",
        "params": {
          "subscriptionId": "sub-1",
          "value": {
            "total": 42
          }
        }
      },
      "notBefore": "subscribed"
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "s-2",
        "method": "resources/unsubscribe",
        "params": {
          "subscriptionId": "sub-1"
        }
      }
    },
    {
      "recv": {
        "jsonrpc": "2.0",
        "id": "s-2"
      }
    },
    {
      "expectSilence": {
        "method": "resources/updated"
      },
      "timeoutMs": 500,
      "note": "The subscriber's cleanup function must have run. A further update here is a leak."
    }
  ]
}
