{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tesseron Todo",
  "version": "0.1.0",
  "identifier": "dev.tesseron.tauri-todo",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tesseron Todo",
        "width": 760,
        "height": 680,
        "minWidth": 520,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
