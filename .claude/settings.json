{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-docs-index.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "developer-kit-typescript@developer-kit": false,
    "live-rules@eigenwise-toolshed": true,
    "codebase-mapper@eigenwise-toolshed": true,
    "model-gateway@eigenwise-toolshed": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "developer-kit": {
      "source": {
        "source": "github",
        "repo": "giuseppe-trisciuoglio/developer-kit"
      }
    },
    "eigenwise-toolshed": {
      "source": {
        "source": "github",
        "repo": "Eigenwise/eigenwise-toolshed"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    }
  }
}
